DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=True
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional absolute API URL used in the generated OpenAPI schema.
# Leave empty locally so Swagger uses the current host.
API_SERVER_URL=

DB_ENGINE=django.db.backends.postgresql
DB_NAME=agency_db
DB_USER=agency_user
DB_PASSWORD=agency_secure_password
DB_HOST=db
DB_PORT=5432

# Production HTTPS settings. Enable these only after HTTPS and the reverse
# proxy are configured correctly.
TRUST_PROXY_HEADERS=False
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
