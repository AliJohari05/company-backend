DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=True
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax
ACCESS_TOKEN_COOKIE_NAME=ctrlops_access
REFRESH_TOKEN_COOKIE_NAME=ctrlops_refresh

# Optional absolute API URL used in the generated OpenAPI schema.
# Leave empty locally so Swagger uses the current host.
API_SERVER_URL=
FRONTEND_URL=http://localhost:5173

# Email verification. The console backend prints messages in the web
# container during local development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=CtrlOps <no-reply@ctrlops.local>
EMAIL_VERIFICATION_TIMEOUT=86400

DB_ENGINE=django.db.backends.postgresql
DB_NAME=agency_db
DB_USER=agency_user
DB_PASSWORD=agency_secure_password
DB_HOST=db
DB_PORT=5432

# Local Redis/Celery settings used by docker compose.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=development-only-redis-password
CELERY_WORKER_CONCURRENCY=2

# Production HTTPS settings. Enable these only after HTTPS and the reverse
# proxy are configured correctly.
TRUST_PROXY_HEADERS=False
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
