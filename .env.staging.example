DEBUG=False
SECRET_KEY=replace-this-with-a-unique-random-secret-of-at-least-64-characters

STAGING_DOMAIN=api-staging.example.com
ACME_EMAIL=admin@example.com
ALLOWED_HOSTS=api-staging.example.com
API_SERVER_URL=https://api-staging.example.com
FRONTEND_URL=https://staging.example.com

CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://staging.example.com
CORS_ALLOW_CREDENTIALS=True
CSRF_TRUSTED_ORIGINS=https://staging.example.com
AUTH_COOKIE_SECURE=True
AUTH_COOKIE_SAMESITE=Lax
ACCESS_TOKEN_COOKIE_NAME=ctrlops_access
REFRESH_TOKEN_COOKIE_NAME=ctrlops_refresh

DB_ENGINE=django.db.backends.postgresql
POSTGRES_DB=ctrlops_staging
POSTGRES_USER=ctrlops_staging
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DB_HOST=db
DB_PORT=5432

# Redis is internal-only in Docker and is used for Celery and the Django cache.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-long-random-redis-password
CELERY_WORKER_CONCURRENCY=2

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=CtrlOps <no-reply@example.com>
EMAIL_VERIFICATION_TIMEOUT=86400

TRUST_PROXY_HEADERS=True
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False

API_DOCS_ENABLED=True
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
DJANGO_LOG_LEVEL=INFO
