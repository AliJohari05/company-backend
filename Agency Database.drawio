    <diagram id="HOIAMitqKrjz8gQ7e0hs" name="Page-3">
        <mxGraphModel dx="3392" dy="1602" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{\n  init: {\n    &#39;theme&#39;: &#39;base&#39;,\n    &#39;themeVariables&#39;: {\n      &#39;primaryColor&#39;: &#39;#E0E7FF&#39;,\n      &#39;primaryTextColor&#39;: &#39;#1E1B4B&#39;,\n      &#39;primaryBorderColor&#39;: &#39;#6366F1&#39;,\n      &#39;lineColor&#39;: &#39;#4338CA&#39;,\n      &#39;tertiaryColor&#39;: &#39;#F8FAFC&#39;\n    }\n  }\n}%%\n\nerDiagram\n\n    %% ==========================================\n    %% CORE &amp; ACCOUNTS MODULE\n    %% ==========================================\n\n    User {\n        UUID id PK\n        VARCHAR email UK\n        VARCHAR password\n        VARCHAR first_name\n        VARCHAR last_name\n        VARCHAR phone_number\n        VARCHAR company_name\n        UserRole role\n        BOOLEAN is_active\n        BOOLEAN is_staff\n        TIMESTAMP created_at\n        TIMESTAMP updated_at\n    }\n\n    UserRole {\n        STRING ADMIN\n        STRING STAFF\n        STRING CLIENT\n    }\n\n    %% ==========================================\n    %% SERVICES MODULE\n    %% ==========================================\n\n    ServiceCategory {\n        UUID id PK\n        VARCHAR title\n        VARCHAR slug UK\n        TEXT description\n        VARCHAR icon\n        BOOLEAN is_active\n        TIMESTAMP created_at\n        TIMESTAMP updated_at\n    }\n\n    Service {\n        UUID id PK\n        UUID category_id FK\n        VARCHAR title\n        VARCHAR slug UK\n        TEXT short_description\n        TEXT full_description\n        VARCHAR icon\n        BOOLEAN is_active\n        TIMESTAMP created_at\n        TIMESTAMP updated_at\n    }\n\n    ServicePlan {\n        UUID id PK\n        UUID service_id FK\n        VARCHAR title\n        DECIMAL price\n        JSON features\n        TIMESTAMP created_at\n        TIMESTAMP updated_at\n    }\n\n    ProjectRequest {\n        UUID id PK\n        UUID user_id FK\n        UUID service_id FK\n        VARCHAR title\n        TEXT description\n        DECIMAL estimated_budget\n        ProjectStatus status\n        TIMESTAMP created_at\n        TIMESTAMP updated_at\n    }\n\n    ProjectAttachment {\n        UUID id PK\n        UUID project_id FK\n        VARCHAR file_path\n        TIMESTAMP created_at\n    }\n\n    ProjectStatus {\n        STRING PENDING\n        STRING APPROVED\n        STRING IN_PROGRESS\n        STRING COMPLETED\n        STRING REJECTED\n    }\n\n    %% ==========================================\n    %% CONTRACTS &amp; BILLING MODULE\n    %% ==========================================\n\n    Contract {\n        UUID id PK\n        UUID user_id FK\n        UUID project_request_id FK\n        VARCHAR contract_number UK\n        TEXT title\n        TEXT terms_and_conditions\n        DECIMAL total_amount\n        ContractStatus status\n        TIMESTAMP start_date\n        TIMESTAMP end_date\n        TIMESTAMP signed_at\n        TIMESTAMP created_at\n        TIMESTAMP updated_at\n    }\n\n    Invoice {\n        UUID id PK\n        UUID user_id FK\n        UUID contract_id FK\n        VARCHAR invoice_number UK\n        DECIMAL total_amount\n        InvoiceStatus status\n        TIMESTAMP due_date\n        TIMESTAMP paid_at\n        TIMESTAMP created_at\n        TIMESTAMP updated_at\n    }\n\n    InvoiceItem {\n        UUID id PK\n        UUID invoice_id FK\n        VARCHAR description\n        INTEGER quantity\n        DECIMAL unit_price\n        DECIMAL total_price\n    }\n\n    ContractStatus {\n        STRING DRAFT\n        STRING PENDING_SIGNATURE\n        STRING ACTIVE\n        STRING COMPLETED\n        STRING TERMINATED\n    }\n\n    InvoiceStatus {\n        STRING DRAFT\n        STRING PENDING\n        STRING PAID\n        STRING OVERDUE\n        STRING CANCELED\n    }\n\n    %% ==========================================\n    %% TICKETING MODULE\n    %% ==========================================\n\n    Ticket {\n        UUID id PK\n        UUID user_id FK\n        VARCHAR title\n        TicketPriority priority\n        TicketStatus status\n        TIMESTAMP created_at\n        TIMESTAMP updated_at\n    }\n\n    TicketMessage {\n        UUID id PK\n        UUID ticket_id FK\n        UUID user_id FK\n        TEXT message\n        VARCHAR attachment\n        TIMESTAMP created_at\n        TIMESTAMP updated_at\n    }\n\n    TicketPriority {\n        STRING LOW\n        STRING MEDIUM\n        STRING HIGH\n    }\n\n    TicketStatus {\n        STRING OPEN\n        STRING PENDING\n        STRING ANSWERED\n        STRING IN_PROGRESS\n        STRING RESOLVED\n        STRING CLOSED\n    }\n\n    %% ==========================================\n    %% BLOG MODULE\n    %% ==========================================\n\n    BlogCategory {\n        UUID id PK\n        VARCHAR name\n        VARCHAR slug UK\n        TEXT description\n        TIMESTAMP created_at\n        TIMESTAMP updated_at\n    }\n\n    BlogTag {\n        UUID id PK\n        VARCHAR name\n        VARCHAR slug UK\n        TIMESTAMP created_at\n        TIMESTAMP updated_at\n    }\n\n    Post {\n        UUID id PK\n        UUID author_id FK\n        UUID category_id FK\n        VARCHAR title\n        VARCHAR slug UK\n        TEXT content\n        VARCHAR featured_image\n        TEXT meta_description\n        INTEGER views_count\n        BOOLEAN is_published\n        TIMESTAMP published_at\n        TIMESTAMP created_at\n        TIMESTAMP updated_at\n    }\n\n    PostTag {\n        UUID post_id PK_FK\n        UUID tag_id PK_FK\n    }\n\n    %% ==========================================\n    %% PORTFOLIO MODULE\n    %% ==========================================\n\n    PortfolioCategory {\n        UUID id PK\n        VARCHAR title\n        VARCHAR slug UK\n        TEXT description\n        TIMESTAMP created_at\n        TIMESTAMP updated_at\n    }\n\n    PortfolioItem {\n        UUID id PK\n        UUID category_id FK\n        VARCHAR title\n        VARCHAR slug UK\n        VARCHAR client_name\n        VARCHAR project_url\n        TEXT description\n        VARCHAR cover_image\n        TIMESTAMP completion_date\n        BOOLEAN is_featured\n        TIMESTAMP created_at\n        TIMESTAMP updated_at\n    }\n\n    PortfolioImage {\n        UUID id PK\n        UUID portfolio_item_id FK\n        VARCHAR image\n        VARCHAR caption\n        INTEGER display_order\n        TIMESTAMP created_at\n    }\n\n    %% ==========================================\n    %% RELATIONSHIPS\n    %% ==========================================\n\n    %% Services &amp; Projects\n    ServiceCategory ||--|{ Service : \&quot;contains\&quot;\n    Service ||--|{ ServicePlan : \&quot;offers\&quot;\n    User ||--o{ ProjectRequest : \&quot;creates\&quot;\n    Service ||--|{ ProjectRequest : \&quot;linked_to\&quot;\n    ProjectRequest ||--|{ ProjectAttachment : \&quot;has\&quot;\n\n    %% Contracts &amp; Billing\n    User ||--o{ Contract : \&quot;signs\&quot;\n    ProjectRequest ||--o| Contract : \&quot;generates\&quot;\n    Contract ||--o{ Invoice : \&quot;bills_via\&quot;\n    User ||--o{ Invoice : \&quot;billed_to\&quot;\n    Invoice ||--|{ InvoiceItem : \&quot;includes\&quot;\n\n    %% Ticketing\n    User ||--|{ Ticket : \&quot;opens\&quot;\n    Ticket ||--|{ TicketMessage : \&quot;contains\&quot;\n    User ||--|{ TicketMessage : \&quot;sends\&quot;\n\n    %% Blog\n    User ||--o{ Post : \&quot;authors\&quot;\n    BlogCategory ||--o{ Post : \&quot;categorizes\&quot;\n    Post ||--|{ PostTag : \&quot;has\&quot;\n    BlogTag ||--|{ PostTag : \&quot;tagged_in\&quot;\n\n    %% Portfolio\n    PortfolioCategory ||--o{ PortfolioItem : \&quot;categorizes\&quot;\n    PortfolioItem ||--|{ PortfolioImage : \&quot;gallery\&quot;&quot;&#xa;}" id="g7B1ASihH31uowo1hMOd-3">
                    <mxCell style="shape=image;noLabel=1;verticalAlign=top;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1">
                        <mxGeometry x="-1610" y="-450" width="2369.6005859375" height="2048" as="geometry"/>
                    </mxCell>
                </UserObject>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>